# Local demo: copy to .env and set your own password (12+ characters).
APP_PASSWORD=replace-with-a-long-personal-password
APP_ORIGIN=http://localhost:5173
DEMO_MODE=true
DEMO_BOOKS=12
DATABASE_PATH=data/mangasee.sqlite
PORT=3000
HOST=127.0.0.1
# Real Komga (DEMO_MODE=false):
KOMGA_URL=http://127.0.0.1:25600
KOMGA_API_KEY=
LIBRARY_PATH=/library
# Optional override; otherwise uses LIBRARY_PATH/.mangasee-library:
# LIBRARY_SENTINEL=/library/.mangasee-library
LIBRARY_SENTINEL_VALUE=mangasee-library
# Deployment: set APP_ORIGIN=https://mangasee.home.arpa and DEMO_MODE=false
SITE_ADDRESS=mangasee.home.arpa
# Existing folder on the Docker host, mounted/provisioned by you:
LIBRARY_SOURCE=/mnt/books
DATA_ROOT=/srv/mangasee/data
