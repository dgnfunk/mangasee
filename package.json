{
  "name": "mangasee",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "dev": "concurrently -k \"tsx watch server/index.ts\" \"vite --host 127.0.0.1\"",
    "build": "tsc --noEmit && vite build && tsc -p tsconfig.server.json",
    "start": "node dist-server/server/index.js",
    "test": "tsx --test tests/*.test.ts",
    "test:e2e": "playwright test",
    "check": "npm run test && npm run build",
    "format": "prettier --write src server tests scripts/*.ts *.json *.ts compose.yaml public/offline-worker.js",
    "format:check": "prettier --check src server tests scripts/*.ts *.json *.ts compose.yaml public/offline-worker.js",
    "demo": "npm run build && node --import tsx scripts/demo.ts",
    "test:deploy": "python3 scripts/test-proxmox.py"
  },
  "dependencies": {
    "@fastify/cookie": "^11.0.2",
    "@fastify/rate-limit": "^10.3.0",
    "@fastify/static": "10.1.4",
    "epubjs": "0.3.93",
    "fastify": "^5.6.0",
    "idb": "^8.0.3",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "zod": "^4.1.5"
  },
  "devDependencies": {
    "@playwright/test": "^1.55.0",
    "@types/node": "^26.6.2",
    "@types/react": "^19.1.12",
    "@types/react-dom": "^19.1.9",
    "@vitejs/plugin-react": "^5.0.2",
    "concurrently": "^9.2.1",
    "prettier": "3.8.1",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2",
    "vite": "^7.1.4",
    "vite-plugin-pwa": "^1.0.3"
  },
  "overrides": {
    "@xmldom/xmldom": "0.9.12"
  }
}
